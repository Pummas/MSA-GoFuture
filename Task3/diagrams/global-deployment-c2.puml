@startuml global-deployment-c2
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_LANDSCAPE()
LAYOUT_WITH_LEGEND()
title GoFuture — Global Deployment C2
AddElementTag("task3", $bgColor="#FFE6E6", $fontColor="#000000", $borderColor="#FF0000")
AddRelTag("task3", $lineColor="#FF0000", $textColor="#CC0000")
Person(passenger, "Пассажир", "Заказывает поездку")
Person(driver_user, "Водитель", "Принимает заказ")
System_Ext(psp, "Платёжные провайдеры", "PSP")
System_Ext(maps, "Картографические провайдеры", "Maps/ETA")
System_Ext(push, "Push/SMS/e-mail", "Внешние уведомления")
System_Boundary(edge, "Global Edge — Task3", $tags="task3") {
  Container(geodns, "GeoDNS / Anycast", "DNS + Anycast", "Latency routing и health checks", $tags="task3")
  Container(waf, "WAF / DDoS", "Edge security", "WAF, bot protection, rate limit", $tags="task3")
  Container(glb, "Global LB", "Anycast/LB", "Region affinity и fallback", $tags="task3")
}
System_Boundary(sg, "Singapore — AWS", $tags="task3") {
  Container(sg_gateway, "Gateway/BFF", "HTTPS/mTLS", "Regional API", $tags="task3")
  Container(sg_domains, "Domain services", "Booking, Driver, Pricing, Payments, Geography, Fraud, Notification", "Task1 domains; no Payouts service", $tags="task3")
  ContainerDb(sg_db, "Owned PostgreSQL", "Multi-AZ PostgreSQL", "Regional owner data", $tags="task3")
  ContainerQueue(sg_kafka, "Kafka cluster", "Kafka RF≥3", "region_id topics", $tags="task3")
}
System_Boundary(jakarta, "Jakarta — AWS", $tags="task3") {
  Container(jk_gateway, "Gateway/BFF", "HTTPS/mTLS", "Regional API", $tags="task3")
  Container(jk_domains, "Domain services", "Task1 services", "Regional owner", $tags="task3")
  ContainerDb(jk_db, "Owned PostgreSQL", "Multi-AZ PostgreSQL", "Regional owner data", $tags="task3")
  ContainerQueue(jk_kafka, "Kafka cluster", "Kafka RF≥3", "region_id topics", $tags="task3")
}
System_Boundary(sp, "São Paulo — AWS", $tags="task3") {
  Container(sp_gateway, "Gateway/BFF", "HTTPS/mTLS", "Regional API", $tags="task3")
  Container(sp_domains, "Domain services", "Task1 services", "Regional owner", $tags="task3")
  ContainerDb(sp_db, "Owned PostgreSQL", "Multi-AZ PostgreSQL", "Regional owner data", $tags="task3")
  ContainerQueue(sp_kafka, "Kafka cluster", "Kafka RF≥3", "region_id topics", $tags="task3")
}
System_Boundary(fr, "Frankfurt — AWS", $tags="task3") {
  Container(fr_gateway, "Gateway/BFF", "HTTPS/mTLS", "Regional API", $tags="task3")
  Container(fr_domains, "Domain services", "Task1 services", "Regional owner", $tags="task3")
  ContainerDb(fr_db, "Owned PostgreSQL", "Multi-AZ PostgreSQL", "Regional owner data", $tags="task3")
  ContainerQueue(fr_kafka, "Kafka cluster", "Kafka RF≥3", "region_id topics", $tags="task3")
}
System_Boundary(platform, "Shared migration/observability", $tags="task3") {
  Container(yc, "Yandex Cloud contour", "Current/migration", "Legacy and Strangler fallback", $tags="task3")
  Container(replication, "Replication/Fencing", "WAL + Kafka Mirror + lease", "Ownership, promotion, split-brain protection", $tags="task3")
  Container(obs, "Observability", "OTel/Prometheus/Grafana/Loki/Tempo", "Global SLO, RPO/RTO, lag and alerts", $tags="task3")
  Container(analytics, "Analytics/Flink", "Regional consumers", "Replay and aggregate projections", $tags="task3")
}
Rel(passenger, geodns, "HTTPS", $tags="task3")
Rel(driver_user, geodns, "HTTPS + telemetry", $tags="task3")
Rel(geodns, waf, "Healthy nearest region", $tags="task3")
Rel(waf, glb, "Filtered traffic", $tags="task3")
Rel(glb, sg_gateway, "Affinity/fallback", $tags="task3")
Rel(glb, jk_gateway, "Affinity/fallback", $tags="task3")
Rel(glb, sp_gateway, "Affinity/fallback", $tags="task3")
Rel(glb, fr_gateway, "Affinity/fallback", $tags="task3")
Rel(sg_gateway, sg_domains, "API", $tags="task3")
Rel(jk_gateway, jk_domains, "API", $tags="task3")
Rel(sp_gateway, sp_domains, "API", $tags="task3")
Rel(fr_gateway, fr_domains, "API", $tags="task3")
Rel(sg_domains, sg_db, "Owns/write", $tags="task3")
Rel(jk_domains, jk_db, "Owns/write", $tags="task3")
Rel(sp_domains, sp_db, "Owns/write", $tags="task3")
Rel(fr_domains, fr_db, "Owns/write", $tags="task3")
Rel(sg_domains, sg_kafka, "Outbox/CDC", $tags="task3")
Rel(jk_domains, jk_kafka, "Outbox/CDC", $tags="task3")
Rel(sp_domains, sp_kafka, "Outbox/CDC", $tags="task3")
Rel(fr_domains, fr_kafka, "Outbox/CDC", $tags="task3")
Rel(sg_kafka, replication, "Mirror permitted topics", $tags="task3")
Rel(jk_kafka, replication, "Mirror permitted topics", $tags="task3")
Rel(sp_kafka, replication, "Mirror permitted topics", $tags="task3")
Rel(fr_kafka, replication, "Mirror permitted topics", $tags="task3")
Rel(replication, sg_db, "Promotion/fencing", $tags="task3")
Rel(replication, jk_db, "Promotion/fencing", $tags="task3")
Rel(replication, sp_db, "Promotion/fencing", $tags="task3")
Rel(replication, fr_db, "Promotion/fencing", $tags="task3")
Rel(sg_kafka, analytics, "Events/replay", $tags="task3")
Rel(jk_kafka, analytics, "Events/replay", $tags="task3")
Rel(sp_kafka, analytics, "Events/replay", $tags="task3")
Rel(fr_kafka, analytics, "Events/replay", $tags="task3")
Rel(sg_domains, obs, "Metrics/logs/traces", $tags="task3")
Rel(jk_domains, obs, "Metrics/logs/traces", $tags="task3")
Rel(sp_domains, obs, "Metrics/logs/traces", $tags="task3")
Rel(fr_domains, obs, "Metrics/logs/traces", $tags="task3")
Rel(yc, sg_gateway, "Migration/fallback", $tags="task3")
Rel(sg_domains, psp, "Authorize/capture", $tags="task3")
Rel(sg_domains, maps, "Route/ETA", $tags="task3")
Rel(sg_domains, push, "Notifications", $tags="task3")
SHOW_LEGEND()
@enduml
